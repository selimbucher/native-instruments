; Maschine MK3: nimk3.sys on the display and audio interfaces, no driver on
; the other interfaces NI's nimc3usb.inf also claims (README.md).
; Wine picks the first of equally ranked drivers in file name order, this
; name sorts before nimc3usb.inf.

[Version]
Signature="$Windows NT$"
Class=NIUSBDevice
ClassGuid={E76E9530-E0A0-4B82-A618-D3F60C00DDF4}
Provider=%Provider%
DriverVer=11/07/2026,1.1.0.0

[Manufacturer]
%Provider%=Models,NTamd64

[Models.NTamd64]
%Display%=Nimk3,USB\VID_17CC&PID_1600&MI_05
%Audio%=Nimk3,USB\VID_17CC&PID_1600&MI_00
%Update%=NoDriver,USB\VID_17CC&PID_1600&MI_06
%Update%=NoDriver,USB\VID_17CC&PID_1602

[Nimk3.NTamd64]

[Nimk3.NTamd64.Services]
AddService=nimk3,0x00000002,Service

[Service]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\nimk3.sys

[NoDriver.NTamd64]

[NoDriver.NTamd64.Services]
AddService=,0x00000002

[Strings]
Provider="ni-wine"
Display="Maschine MK3 Display"
Audio="Maschine MK3 Audio"
Update="Maschine MK3 Firmware Update"
